{
  "manifest_version": 3,
  "name": "SmartGov PBB Auto Printer",
  "version": "1.2",
  "description": "Ekstensi otomatisasi cetak masal SPPT/STTS dan Catatan Pembayaran SmartGov PBB",
  "permissions": [
    "activeTab",
    "downloads",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["content.js"]
    }
  ]
}